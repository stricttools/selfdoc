# Build output
dist/
# Anchored: the release artifact directory is the one at the repository root,
# and an unanchored pattern also matched the Go build pipeline's package at
# internal/build/.
/build/

# Node
node_modules/
npm-debug.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Wrangler
.wrangler/

# rlsbl
.rlsbl-notes-*.tmp
.rlsbl/lock
.credentials.json
.*-cache.json
.env
.env.local
*.local-only

*.log
coverage/

.rlsbl/releases/in-progress.json
.rlsbl/releases/scrub-result.json

# Go build output
/bin/*

# fleet-diff scratch root (clones, snapshots, normalized trees, report)
/.fleet-diff/

# uv/virtualenv
/.venv/

__pycache__/
*.pyc
target/
*.egg-info/

.rlsbl-monorepo/lock
.rlsbl-monorepo/releasables/*/releases/in-progress.json
.rlsbl-monorepo/releasables/*/releases/scrub-result.json

# Local co-development overlay of sibling checkouts (for example an unreleased
# strictspec). Never committed: a release builds against the published modules.
/go.work
/go.work.sum

build/
