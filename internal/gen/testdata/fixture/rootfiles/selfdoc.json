{
  "source": [
    {
      "path": "mylib/",
      "language": "python"
    }
  ],
  "docs": ".strictmetadata/docs/",
  "output": ".strictmetadata/.docs-cache/build/",
  "base_url": "https://example.com",
  "search_engine": "pagefind",
  "root_files": [
    {
      "template": ".strictmetadata/docs/_TEST.md",
      "outputs": [
        "TEST.md"
      ]
    }
  ],
  "topology": {
    "docs_base": "https://docs.example.dev",
    "slug": "mylib",
    "posts_base": "https://docs.example.dev/blog"
  }
}
